{
  "id": "nether",
  "format_version": 2,
  "mask_categories": {
    "vegetation": ["crimson_fungi", "crimson_ground", "warped_fungi", "warped_ground", "twisting_vines"],
    "clearance": ["crimson_fungi", "crimson_ground", "warped_fungi", "warped_ground", "twisting_vines", "fire", "fossils", "glowstone"]
  },
  "version": 18,
  "name": {"zh": "下界", "en": "Nether"},
  "description": {"zh": "默认四群系；所有群系预设加入玄武岩柱簇与零散静态熔池。", "en": "Four biomes by default; All biomes adds basalt clusters and scattered static lava pockets."},
  "modules": ["terrain"],
  "height_field": "height",
  "density": {"field": "nether_solid", "base": "volume"},
  "water": {"block": "lava_surface", "mask_field": "lava_presence", "generate_param": "nether.lava_enabled"},
  "fluids": {"sampler": "basalt:fluids", "block": "lava_surface", "enabled_param": "basalt.pools_enabled", "requires": ["basalt.enabled"]},
  "shell_materials": {"sampler": "materials:sample", "blocks": ["blackstone", "basalt", "soul_sand", "soul_soil", "gravel", "nether_quartz_ore", "nether_gold_ore", "magma_block", "crimson_nylium", "warped_nylium"], "surface_depth": 4, "surface_depth_enabled_param": "soul.enabled"},
  "biomes": ["nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas"],
  "block_order": [
    "netherrack", "bone_block", "glowstone", "lava", "crimson_nylium", "crimson_stem", "nether_wart_block", "shroomlight", "weeping_vines", "weeping_vines_plant",
    "lava_surface", "blackstone", "basalt", "soul_sand", "soul_soil", "gravel", "nether_quartz_ore", "nether_gold_ore", "magma_block", "fire_floor", "soul_fire_floor", "crimson_fungus", "crimson_roots",
    "warped_nylium", "warped_stem", "warped_wart_block", "warped_fungus", "warped_roots", "nether_sprouts", "twisting_vines", "twisting_vines_plant"
  ],
  "biome_parameters": {"soul_region": 1, "crimson_region": 1, "warped_region": 1, "basalt_region": 1},
  "planners": {"soul_pillars": "pillars:plan", "basalt_pools": "basalt:pools", "basalt_columns": "basalt:columns"},
  "planner_gates": {"soul_pillars": ["soul.enabled", "soul.pillars_enabled"], "basalt_pools": ["basalt.enabled", "basalt.pools_enabled"], "basalt_columns": ["basalt.enabled"]},
