{
  "id": "badlands",
  "color": "#BA673E",
  "vegetation_tint": [1.6, 1.1, 0.6, 0.5],
  "vegetation_hsv": [0.88, 0.85, 1.0],
  "climate": [{"badlands_mask": [0.5, null]}],
  "surface": [
    {"when": {"surface_rock": {"min": 0}}, "top": "terracotta", "under": "terracotta", "deep": "terracotta"},
    {"top": "red_sand", "under": "red_sandstone", "deep": "terracotta"}
  ],
  "features": {
    "bush": {
      "surface": ["red_sand"],
      "density": "$vegetation.bush_density",
      "patch_scale": "$vegetation.patch_scale",
      "max_slope": "$vegetation.max_slope",
      "enabled_param": "vegetation.enabled"
    }
  }
}
