  "surface_overrides": [
    {
      "when": {"shore_depth": {"min": 0}, "surface_rock": {"min": 0}, "foothill_temperature": {"min": 0.2}, "humidity": {"max": -0.2}},
      "top": "sandstone",
      "under": "sandstone",
      "deep": "sandstone"
    },
    {"when": {"shore_depth": {"min": 0}, "surface_rock": {"min": 0}}, "top": "stone", "under": "stone", "deep": "stone"},
    {
      "when": {"shore_depth": {"min": 0}, "shore_cover_weight": {"min": 0.05}, "foothill_temperature": {"min": 0.2}, "humidity": {"max": -0.2}},
      "top": "sand",
      "under": "sand",
      "deep": "sandstone"
    },
    {"when": {"shore_depth": {"min": 0}, "shore_cover_weight": {"min": 0.05}}, "top": "dirt", "under": "dirt", "deep": "stone"},
    {"when": {"water_kind": {"min": 2, "max": 3}, "shore_depth": {"min": 0}}, "top": [["gravel", 5], ["dirt", 3], ["sand", 2]]},
    {
      "when": {"water_kind": {"min": 2}, "shore_depth": {"min": "$surface.shallow_depth"}},
      "top": [["sand", 3], ["gravel", 1]],
      "under": "sand",
      "deep": "stone"
    },
    {
      "when": {
        "water_kind": [1, 2],
        "shore_depth": {"min": "$surface.shallow_depth"},
        "seabed_deposit": {"min": 0.25},
        "seabed_deposit_kind": {"min": 0}
      },
      "top": "gravel",
      "under": "sand",
      "deep": "stone"
    },
    {
      "when": {"water_kind": [1, 2], "shore_depth": {"min": "$surface.shallow_depth"}, "seabed_deposit": {"min": 0.25}},
      "top": "dirt",
      "under": "sand",
      "deep": "stone"
    },
    {"when": {"water_kind": [1, 2], "shore_depth": {"min": "$surface.shallow_depth"}}, "top": "sand", "under": "sand", "deep": "stone"},
    {
      "when": {
        "island_weight": {"min": 0.01},
        "shore_depth": {"max": 0},
        "shore_cover_weight": {"min": 0.05},
        "altitude": {"min": 0, "max": 2},
        "surface_rock": {"max": 0},
        "snow_cover": {"max": 0.5}
      },
      "top": "sand",
      "under": "sand",
      "deep": "stone"
    }
  ],
