{
  "id": "end",
  "format_version": 3,
  "version": 6,
  "modules": ["terrain"],
  "height_field": "height",
  "reference_mask_field": "island_presence",
  "density": {"field": "end_solid", "base": "volume"},
  "shell_materials": {"sampler": "terrain:materials", "blocks": ["obsidian", "bedrock"]},
  "surface_processors": [
    {
      "id": "end_monuments",
      "function": "monuments:apply",
      "blocks": ["bedrock", "end_portal_surface"],
      "radius": 0,
      "volume": true,
      "sky_only": true,
      "unit_replace": true,
      "enabled_param": "monuments.portal"
    }
  ],
  "mask_categories": {"vegetation": ["chorus"], "clearance": ["chorus"]},
  "biome_parameters": {"end_biome": 1},
  "biomes": ["the_end", "end_highlands", "end_midlands", "end_barrens", "small_end_islands"],
  "default_preset": "",
  "preset_menu": ["full_end"],
  "pages": ["world", "end", "chorus", "monuments", "surface"],
  "ui_sections": {
    "world": {"pages": ["world"]},
    "end": {"pages": ["end"]},
    "chorus": {"pages": ["chorus"], "controls": ["chorus.enabled"]},
    "monuments": {"pages": ["monuments"]},
    "surface": {"pages": ["surface"], "editor": "surface"}
  },
  "params": {
    "world.y_min": {"type": "int", "default": 0, "min": -1024, "max": 4095},
    "world.y_max": {"type": "int", "default": 160, "min": -1023, "max": 4096},
    "world.sea_level": {"type": "float", "default": 32, "advanced": true},
    "surface.soil_depth": {"type": "int", "default": 3, "min": 0, "max": 16, "advanced": true},
    "surface.boundary_scale": {"type": "float", "default": 16, "min": 1, "max": 256, "advanced": true},
    "surface.patch_scale": {"type": "float", "default": 16, "min": 1, "max": 256, "advanced": true},
    "end.layout": {"type": "str", "default": "outer", "advanced": true},
    "end.center_x": {"type": "int", "default": 0, "min": -10000000, "max": 10000000},
    "end.center_z": {"type": "int", "default": 0, "min": -10000000, "max": 10000000},
    "end.main_radius": {"type": "float", "default": 96, "min": 64, "max": 512},
    "end.outer_start": {"type": "float", "default": 1024, "min": 256, "max": 8192},
    "end.scale": {"type": "float", "default": 128, "min": 48, "max": 384},
    "end.density": {"type": "float", "default": 0.85, "min": 0, "max": 1},
    "end.height": {"type": "float", "default": 64, "min": -512, "max": 2048},
    "end.relief": {"type": "float", "default": 12, "min": 0, "max": 64},
    "end.thickness": {"type": "float", "default": 36, "min": 8, "max": 128},
    "chorus.enabled": {"type": "bool", "default": true},
    "chorus.whole_tree": {"type": "bool", "default": true, "enabled_param": "chorus.enabled"},
    "chorus.density": {"type": "float", "default": 0.55, "min": 0, "max": 1, "enabled_param": "chorus.enabled"},
    "chorus.spacing": {"type": "int", "default": 8, "min": 6, "max": 64, "enabled_param": "chorus.enabled"},
    "chorus.max_slope": {"type": "float", "default": 1.4, "min": 0, "max": 8, "advanced": true, "enabled_param": "chorus.enabled"},
    "monuments.pillars": {"type": "bool", "default": true},
    "monuments.portal": {"type": "bool", "default": true}
  }
}
